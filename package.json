{
  "name": "escape-room-hub",
  "version": "0.0.0",
  "private": true,
  "description": "A policy-aware escape-room availability Web, API, worker, and MCP scaffold.",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.16.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "biome check .",
    "db:check": "pnpm --filter @escape-room-hub/db run db:check",
    "db:generate": "pnpm --filter @escape-room-hub/db run db:generate",
    "db:migrate": "node --env-file-if-exists=.env --run db:migrate:raw",
    "db:migrate:raw": "pnpm --filter @escape-room-hub/db db:migrate",
    "dev": "node --env-file-if-exists=.env --run dev:raw",
    "dev:raw": "pnpm --recursive --parallel --if-present run dev",
    "dev:api": "node --env-file-if-exists=.env --run dev:api:raw",
    "dev:api:raw": "pnpm --filter @escape-room-hub/api dev",
    "dev:mcp:http": "node --env-file-if-exists=.env --run dev:mcp:http:raw",
    "dev:mcp:http:raw": "pnpm --filter @escape-room-hub/mcp dev:http",
    "dev:mcp:stdio": "node --env-file-if-exists=.env --run dev:mcp:stdio:raw",
    "dev:mcp:stdio:raw": "pnpm --filter @escape-room-hub/mcp dev:stdio",
    "dev:web": "node --env-file-if-exists=.env --run dev:web:raw",
    "dev:web:raw": "pnpm --filter @escape-room-hub/web dev",
    "dev:worker": "node --env-file-if-exists=.env --run dev:worker:raw",
    "dev:worker:raw": "pnpm --filter @escape-room-hub/worker dev",
    "format:check": "biome format .",
    "ingest:fixture": "node --env-file-if-exists=.env --run ingest:fixture:raw",
    "ingest:fixture:raw": "pnpm --filter @escape-room-hub/worker ingest:fixture",
    "lint": "biome lint .",
    "predev": "pnpm --filter './packages/**' --if-present run build",
    "pretest": "pnpm --filter './packages/**' --if-present run build",
    "research:validate": "pnpm --filter @escape-room-hub/contracts build && node packages/contracts/dist/validate-manifest.js ../escape-room-hub-research/sources/*.provider.json",
    "test": "pnpm --recursive --if-present run test",
    "test:integration": "node --env-file-if-exists=.env --run test:integration:raw",
    "test:integration:raw": "pnpm --filter @escape-room-hub/worker test:integration",
    "typecheck": "pnpm --filter './packages/**' --if-present run build && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.10.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
